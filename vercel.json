{
  "crons": [
    {
      "path": "/api/cleanup-archived-ads",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cleanup-booking-receipts",
      "schedule": "45 2 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index?path=$1"
    },
    {
      "src": "^/__/auth/(.*)$",
      "dest": "https://dance-with-me-35e98.firebaseapp.com/__/auth/$1"
    },
    {
      "src": "^/login/?$",
      "dest": "/login.html"
    },
    {
      "src": "^/register/?$",
      "dest": "/register.html"
    },
    {
      "src": "^/sitemap.xml$",
      "dest": "/api/index?path=sitemap"
    },
    {
      "src": "^/e/([^/]+)/?$",
      "dest": "/api/index?path=og-event&event=$1"
    },
    {
      "src": "^/event/([^/]+)/?$",
      "dest": "/api/index?path=og-event&event=$1"
    },
    {
      "src": "^/categories/([^/]+)\\.html$",
      "dest": "/api/index?path=og-event&page=$1"
    },
    {
      "src": "^/$",
      "dest": "/api/index?path=og-event&page=home"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
